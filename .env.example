# Copie ce fichier en .env et remplis tes clés.

# --- OpenRouter : script (Claude) + illustrations (Gemini Image) + voix ElevenLabs par défaut
OPENROUTER_API_KEY=
OPENROUTER_WRITER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Voix ElevenLabs servies par OpenRouter (utilisées seulement sans ELEVENLABS_API_KEY) :
# george, daniel, adam, brian, charlie, roger, will...
OPENROUTER_TTS_MODEL=elevenlabs/eleven-multilingual-v2
OPENROUTER_TTS_VOICE=daniel

# --- ElevenLabs direct : obligatoire pour les voix de la Voice Library (Benjamin, Yarik)
# OpenRouter n'expose que les voix ElevenLabs par défaut.
ELEVENLABS_API_KEY=
# Noms (première trouvée utilisée) ou voice_id directement
# Laisser vide pour utiliser la voix de la marque (brand.json), sinon nom(s) ou voice_id
# ELEVENLABS_VOICE=Benjamin,Yarik
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.05

# --- Upload-Post : publication Instagram / YouTube / LinkedIn
UPLOAD_POST_API_KEY=
# Profil Upload-Post (sinon celui de brands/<marque>/brand.json → publish.user)
UPLOAD_POST_USER=
